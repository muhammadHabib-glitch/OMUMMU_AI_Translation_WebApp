# Frontend talks only to Omummu backend — never put OpenAI/Google secrets here.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Google OAuth Web client ID (public — same value as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Optional — Stripe publishable key (checkout uses server redirect; only needed for future Stripe.js embeds)
VITE_STRIPE_PUBLISHABLE_KEY=
